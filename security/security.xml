<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_aio_management" model="ir.module.category">
            <field name="name">AIO Management</field>
            <field name="description">Hak Akses untuk Modul AIO Management (Zink)</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_aio_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_aio_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_aio_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_aio_management"/>
            <field name="implied_ids" eval="[(4, ref('group_aio_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
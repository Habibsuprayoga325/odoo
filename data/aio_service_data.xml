<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_pool_cleaning" model="ir.sequence">
            <field name="name">Referensi Pembersihan Kolam</field>
            <field name="code">pool.cleaning</field>
            <field name="prefix">CLN/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="division_pool" model="aio.division">
            <field name="name">Layanan Kolam Renang</field>
            <field name="code">pool</field>
            <field name="sequence">10</field>
            <field name="description">Divisi khusus untuk perawatan, pembersihan, dan perbaikan kolam renang pelanggan.</field>
        </record>

        <record id="division_garden" model="aio.division">
            <field name="name">Layanan Taman (Coming Soon)</field>
            <field name="code">garden</field>
            <field name="sequence">20</field>
            <field name="description">Divisi perawatan taman dan lanskap.</field>
        </record>
    </data>
</odoo>
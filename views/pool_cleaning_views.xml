<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cleaning Tree View -->
    <record id="view_pool_cleaning_tree" model="ir.ui.view">
        <field name="name">pool.cleaning.tree</field>
        <field name="model">pool.cleaning</field>
        <field name="arch" type="xml">
            <tree string="Pool Cleanings" 
                  decoration-muted="state in ['cancelled','postponed']"
                  decoration-success="state == 'completed'"
                  decoration-warning="is_overdue">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="scheduled_date"/>
                <field name="cleaning_type"/>
                <field name="state" widget="badge"
                       decoration-info="state in ['draft','scheduled']"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state == 'completed'"
                       decoration-danger="state in ['postponed','cancelled']"/>
                <field name="payment_status" widget="badge"
                       decoration-danger="payment_status == 'unpaid'"
                       decoration-warning="payment_status == 'partial'"
                       decoration-success="payment_status == 'paid'"/>
                <field name="total_cost" sum="Total"/>
                <field name="is_overdue" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Cleaning Form View -->
    <record id="view_pool_cleaning_form" model="ir.ui.view">
        <field name="name">pool.cleaning.form</field>
        <field name="model">pool.cleaning</field>
        <field name="arch" type="xml">
            <form string="Pool Cleaning">
                <header>
                    <button name="action_schedule" string="Schedule" type="object" 
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_start" string="Start Cleaning" type="object"
                            invisible="state != 'scheduled'" class="oe_highlight"/>
                    <button name="action_complete" string="Complete" type="object"
                            invisible="state != 'in_progress'" class="oe_highlight"/>
                    <button name="action_postpone" string="Postpone" type="object"
                            invisible="state not in ['draft','scheduled']"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ['completed','cancelled']"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="state not in ['postponed','cancelled']"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,scheduled,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <group>
                        <group string="Customer Information">
                            <field name="name" readonly="1"/>
                            <field name="customer_id" options="{'no_create': False}"/>
                            <field name="customer_phone" readonly="1"/>
                            <field name="pool_volume" readonly="1"/>
                            <field name="service_type" readonly="1"/>
                        </group>
                        <group string="Schedule">
                            <field name="scheduled_date"/>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="duration" readonly="1"/>
                            <field name="is_overdue" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Service Details">
                            <field name="cleaning_type"/>
                            <field name="supervisor_id"/>
                            <field name="cleaner_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Financial">
                            <field name="service_price" readonly="1"/>
                            <field name="additional_cost"/>
                            <field name="total_cost" readonly="1" class="oe_subtotal_footer_separator"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="payment_status"/>
                            <field name="paid_amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Work Details">
                            <group>
                                <field name="work_notes" placeholder="Enter work notes..."/>
                                <field name="chemicals_used" placeholder="List chemicals used..."/>
                                <field name="equipment_used" placeholder="List equipment used..."/>
                            </group>
                        </page>
                        <page string="Customer Feedback" invisible="state != 'completed'">
                            <group>
                                <field name="customer_rating" widget="radio"/>
                                <field name="customer_feedback" placeholder="Customer feedback..."/>
                            </group>
                        </page>
                        <page string="Postpone/Cancel Reason" invisible="state not in ['postponed','cancelled']">
                            <field name="postpone_reason" placeholder="Enter reason..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Cleaning Kanban View -->
    <record id="view_pool_cleaning_kanban" model="ir.ui.view">
        <field name="name">pool.cleaning.kanban</field>
        <field name="model">pool.cleaning</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="scheduled_date"/>
                <field name="state"/>
                <field name="payment_status"/>
                <field name="total_cost"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title"><field name="name"/></strong>
                                        <div class="o_kanban_record_subtitle">
                                            <field name="customer_id"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="scheduled_date"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="payment_status" widget="label_selection" 
                                               options="{'classes': {'unpaid': 'danger', 'partial': 'warning', 'paid': 'success'}}"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="total_cost" widget="monetary"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Cleaning Calendar View -->
    <record id="view_pool_cleaning_calendar" model="ir.ui.view">
        <field name="name">pool.cleaning.calendar</field>
        <field name="model">pool.cleaning</field>
        <field name="arch" type="xml">
            <calendar string="Cleaning Schedule" 
                      date_start="scheduled_date" 
                      color="state" 
                      mode="month">
                <field name="customer_id"/>
                <field name="cleaning_type"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Cleaning Search View -->
    <record id="view_pool_cleaning_search" model="ir.ui.view">
        <field name="name">pool.cleaning.search</field>
        <field name="model">pool.cleaning</field>
        <field name="arch" type="xml">
            <search string="Search Cleanings">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="scheduled_date"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state','=','draft')]"/>
                <filter string="Scheduled" name="filter_scheduled" domain="[('state','=','scheduled')]"/>
                <filter string="In Progress" name="filter_in_progress" domain="[('state','=','in_progress')]"/>
                <filter string="Completed" name="filter_completed" domain="[('state','=','completed')]"/>
                <separator/>
                <filter string="Overdue" name="filter_overdue" domain="[('is_overdue','=',True)]"/>
                <filter string="Unpaid" name="filter_unpaid" domain="[('payment_status','=','unpaid')]"/>
                <separator/>
                <filter string="Today" name="filter_today" 
                        domain="[('scheduled_date','=',context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Customer" name="group_customer" context="{'group_by':'customer_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Date" name="group_date" context="{'group_by':'scheduled_date'}"/>
                    <filter string="Payment Status" name="group_payment" context="{'group_by':'payment_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Cleaning Action -->
    <record id="action_pool_cleaning" model="ir.actions.act_window">
        <field name="name">Pool Cleanings</field>
        <field name="res_model">pool.cleaning</field>
        <field name="view_mode">kanban,tree,form,calendar</field>
        <field name="search_view_id" ref="view_pool_cleaning_search"/>
        <field name="context">{'search_default_filter_scheduled': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Schedule your first cleaning!
            </p>
            <p>
                Create cleaning schedules for your customers.
            </p>
        </field>
    </record>

</odoo>
